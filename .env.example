# Copy to .env.local. All variables are validated in src/lib/env.ts at boot.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Google Maps embed key for location pages (falls back to a link if unset)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Server-only. Where contact-form leads are POSTed as JSON. Required in production;
# without it the form reports an error instead of silently dropping leads.
LEAD_WEBHOOK_URL=

# Instagram feed (home page carousel). See README → "Instagram feed".
# Long-lived token for the @streamline_performance_garage business account.
INSTAGRAM_ACCESS_TOKEN=
# live (default when a token is set) | mock (local placeholders for design review) | off
INSTAGRAM_FEED_MODE=
# Upstash Redis (Vercel Marketplace sets these): holds the weekly-refreshed Instagram token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Server-only, 16+ random characters. Vercel Cron sends it as a Bearer header.
CRON_SECRET=

# Google reviews (home page carousel). See README → "Google reviews".
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# The shop owner's OAuth refresh token (scope business.manage).
GOOGLE_BUSINESS_REFRESH_TOKEN=
# live (default once configured) | mock (labelled samples; ignored in production) | off
GOOGLE_REVIEWS_MODE=
